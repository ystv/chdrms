  "query": "SELECT\n                comments.id,\n                comments.archived_at,\n                comments.title,\n                comments.content,\n                comments.created_at,\n                comments.created_by\n            FROM comments\n            LEFT JOIN asset_comments\n            ON comments.id = asset_comments.comment\n            WHERE asset_comments.asset = $1;",
